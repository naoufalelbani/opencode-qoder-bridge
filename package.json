{
  "name": "opencode-qoder-bridge",
  "version": "0.4.0",
  "description": "Official regional Qoder Agent SDK provider for OpenCode 1 and 2, with browser sign-in, MCP, daily credits, quota and usage history.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "qoder",
    "qoder-ai",
    "qoder-cn",
    "qoder-provider",
    "qoder-agent-sdk",
    "qoder-cli",
    "qoder-quota",
    "qoder-checkin",
    "opencode-v2",
    "ai-coding",
    "coding-agent",
    "mcp"
  ],
  "author": "Naoufal EL BANI",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/naoufalelbani/opencode-qoder-bridge#readme",
  "bugs": {
    "url": "https://github.com/naoufalelbani/opencode-qoder-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naoufalelbani/opencode-qoder-bridge.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opencode-qoder-bridge": "bin/statusline.mjs",
    "qoder-usage": "bin/usage.mjs"
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md",
    "README.md",
    "docs/images",
    "architecture.svg",
    "LICENSE",
    "RELEASING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:stress": "npm run build && node --test test/stress.test.mjs",
    "test:package": "npm run build && node --test test/package-install.test.mjs",
    "test:e2e": "npm run build && node --test test/e2e.test.mjs",
    "audit": "npm audit --audit-level=low",
    "check": "npm run typecheck && npm test && npm run audit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.67",
    "@opencode-ai/plugin": "1.19.0",
    "@opencode/plugin": "2.0.26",
    "@qoder-ai/qoder-agent-sdk": "1.0.51",
    "@qodercn-ai/qodercn-agent-sdk": "1.0.53",
    "jsonc-parser": "3.3.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.27",
    "@opentui/solid": "0.6.6",
    "@types/node": "26.6.5",
    "solid-js": "1.9.17",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.12"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "@babel/core": "8.0.7",
    "@hono/node-server": "2.1.4",
    "@modelcontextprotocol/sdk": "1.32.1",
    "brace-expansion": "5.0.12",
    "fast-uri": "4.2.2",
    "glob": "13.0.6",
    "hono": "4.13.13",
    "minimatch": "10.2.6",
    "seroval": "1.6.9"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "opencode": ">=1.18.29"
  },
  "allowScripts": {
    "@qoder-ai/qoder-agent-sdk@1.0.51": true,
    "@qodercn-ai/qodercn-agent-sdk@1.0.53": true,
    "msgpackr-extract@3.0.4": true
  },
  "directories": {
    "test": "test"
  }
}
