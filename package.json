{
  "name": "opencode-qoder-bridge",
  "version": "0.1.1",
  "description": "opencode plugin that bridges Qoder AI models via @qoder-ai/qoder-agent-sdk",
  "author": "Naoufal El Bani",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/naoufalelbani/opencode-qoder-bridge#readme",
  "bugs": {
    "url": "https://github.com/naoufalelbani/opencode-qoder-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naoufalelbani/opencode-qoder-bridge.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opencode-qoder-bridge": "bin/statusline.mjs",
    "qoder-usage": "bin/usage.mjs"
  },
  "files": [
    "dist",
    "bin",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "RELEASING.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/bridge.test.mjs",
    "audit": "npm audit --audit-level=low",
    "check": "npm run typecheck && npm test && npm run audit",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "@qoder-ai/qoder-agent-sdk": "^1.0.15",
    "jsonc-parser": "^3.3.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^3.0.14",
    "@opencode-ai/plugin": "1.18.5",
    "@opentui/solid": "0.4.5",
    "@types/node": "^22.10.0",
    "solid-js": "1.9.12",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.4.5",
    "solid-js": ">=1.9.12"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "@babel/core": "8.0.1",
    "@hono/node-server": "2.0.11",
    "brace-expansion": "5.0.8",
    "glob": "13.0.6",
    "minimatch": "10.2.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "qoder",
    "ai",
    "llm"
  ]
}
